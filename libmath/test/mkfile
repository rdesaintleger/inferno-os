<../../mkconfig

#
#	Tests of libmath: SoftFloat, and fdlibm ported to SoftFloat.
#
#		mk test
#
#	needs libmath.a installed: mk install in ..
#
#	fptest	SoftFloat against the floating-point hardware of the host
#	oracle	the functions of fdlibm in libmath.a against their reference copy in ref/
#	dtoatest	fd_strtod and fd_dtoa against the strtod and printf of the host
#
#	Both compare bit for bit.  This is only meaningful if the host computes
#	with strict IEEE 754 arithmetic: HOSTFP says how to ask a gcc on x86 for
#	SSE arithmetic, without fused multiply-add.  Another host needs other
#	options: mk HOSTFP='...' test
#

LIB=$ROOT/$OBJDIR/lib/libmath.a

HOSTFP=-frounding-math -ffp-contract=off -fno-math-errno -fno-builtin -msse2 -mfpmath=sse
COUNT=100000

# the same files before the port, with the prefix ref_ (see ref/README)
REF=\
	e_acos\
	e_acosh\
	e_asin\
	e_atan2\
	e_atanh\
	e_cosh\
	e_exp\
	e_fmod\
	e_hypot\
	e_j0\
	e_j1\
	e_jn\
	e_lgamma_r\
	e_log\
	e_log10\
	e_pow\
	e_rem_pio2\
	e_remainder\
	e_sinh\
	e_sqrt\
	k_cos\
	k_rem_pio2\
	k_sin\
	k_tan\
	s_asinh\
	s_atan\
	s_cbrt\
	s_ceil\
	s_copysign\
	s_cos\
	s_erf\
	s_expm1\
	s_fabs\
	s_finite\
	s_floor\
	s_ilogb\
	s_log1p\
	s_modf\
	s_nextafter\
	s_rint\
	s_scalbn\
	s_sin\
	s_tan\
	s_tanh\

REFOBJS=${REF:%=ref_%.$O}

all:V:	test

test:V:	fptest oracle dtoatest
	./fptest $COUNT
	./oracle $COUNT
	./dtoatest

fptest:	fptest.$O $LIB
	$LD $LDFLAGS -o $target fptest.$O $LIB -lm

oracle:	oracle.$O $REFOBJS $LIB
	$LD $LDFLAGS -o $target oracle.$O $REFOBJS $LIB -lm

fptest.$O:	fptest.c $ROOT/include/inferno/fp.h
	$CC $HOSTFP -O0 -w -I$ROOT/include -o $target fptest.c

dtoatest:	dtoatest.$O $LIB
	$LD $LDFLAGS -o $target dtoatest.$O $LIB -lm

dtoatest.$O:	dtoatest.c $ROOT/include/inferno/fp.h
	$CC $HOSTFP -O1 -w -I$ROOT/include -o $target dtoatest.c

oracle.$O:	oracle.c hiwords.h ../fdlibm/fdlibm.h $ROOT/include/inferno/fp.h
	$CC $HOSTFP -O1 -w -I../fdlibm -I$ROOT/include -o $target oracle.c

# reference copy: strict double arithmetic of the host
ref_%.$O:	ref/%.c ref/fdlibm.h
	$CC $HOSTFP -O1 -w -fno-strict-aliasing -D__LITTLE_ENDIAN=1 -Iref -o $target ref/$stem.c

clean:V:
	rm -f *.$O fptest oracle dtoatest

nuke:V:	clean
