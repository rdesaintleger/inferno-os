HFILES=\
	$ROOT/include/mathi.h\
	fdlibm/fdlibm.h\
	$ROOT/include/inferno/fp.h\
	$ROOT/include/inferno/softfloat.h\
	$ROOT/include/inferno/softfloat_types.h\
	
<$ROOT/mkfiles/mksyslib-$SHELLTYPE

# fdlibm: the constants come from a header that fdconst generates
FDCONST=$ROOT/$OBJDIR/bin/fdconst

%.$O:	fdlibm/%.c
	$FDCONST -o $stem.k.h fdlibm/$stem.c
	$CC $CFLAGS -o $target -I. -Ifdlibm fdlibm/$stem.c

clean:V:	clean-k
nuke:V:	clean-k

clean-k:V:
	rm -f *.k.h

# SoftFloat, and the operations of <inferno/fp.h> that are built on it
SFFLAGS=-Isoftfloat/source/include -Isoftfloat/source/RISCV -I$ROOT/include/inferno

%.$O:	softfloat/source/%.c
	$CC $CFLAGS -o $target $SFFLAGS softfloat/source/$stem.c

%.$O:	softfloat/source/RISCV/%.c
	$CC $CFLAGS -o $target $SFFLAGS softfloat/source/RISCV/$stem.c

%.$O:	fp/%.c
	$CC $CFLAGS -o $target fp/$stem.c
