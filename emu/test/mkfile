<../../mkconfig

# Regression tests for emu on the headless configuration (emu-t, no X server).
# Run them with `mk test` in emu/Linux.

DISBIN=$ROOT/dis/test

TARG=\
	chn.dis\
	lblv.dis\
	clash.dis\
	sys.dis\
	math.dis\
	intr.dis\

DATA=\
	run.sh\
	ui.sh\
	dev-env.sh\
	dev-dup.sh\
	dev-prog.sh\
	chn.exp\
	lblv.exp\
	clash.exp\
	sys.exp\
	math.exp\
	intr.exp\
	ui.exp\
	dev-env.exp\
	dev-dup.exp\
	dev-prog.exp\

<$ROOT/mkfiles/mkdis

install:V:	${DATA:%=$DISBIN/%}

$DISBIN/%.sh:	%.sh
	mkdir -p $DISBIN
	rm -f $DISBIN/$stem.sh && cp $stem.sh $DISBIN/$stem.sh

$DISBIN/%.exp:	%.exp
	mkdir -p $DISBIN
	rm -f $DISBIN/$stem.exp && cp $stem.exp $DISBIN/$stem.exp

# mk coverage: which functions of the built-in modules and which devices have a test
coverage:V:
	ROOT=$ROOT sh coverage.sh -u
